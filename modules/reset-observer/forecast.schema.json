{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reset observer generic forecast input",
  "description": "One object per JSONL line. Time fields are UTC Unix seconds. The receiver replaces available_at with its first receipt time.",
  "type": "object",
  "additionalProperties": false,
  "required": ["source", "version", "target", "track", "origin", "available_at", "expires_at", "points", "generated_at"],
  "properties": {
    "source": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "target": {"enum": ["broad_quota_relief", "automatic_reset"]},
    "track": {"enum": ["native", "model", "adapted", "shadow", "community"]},
    "origin": {"type": "number"},
    "available_at": {"type": "number"},
    "generated_at": {"type": "number"},
    "expires_at": {"type": "number"},
    "private": {"type": "boolean"},
    "issues": {"type": "array", "items": {"type": "string"}},
    "metadata": {"type": "object"},
    "points": {
      "type": "array", "minItems": 1,
      "description": "Cumulative probabilities [hours after origin, probability]. Hours strictly increase and probabilities are monotone; the runtime validates these constraints.",
      "items": {"type": "array", "minItems": 2, "maxItems": 2, "prefixItems": [
        {"type": "number", "exclusiveMinimum": 0}, {"type": "number", "minimum": 0, "maximum": 1}
      ], "items": false}
    }
  }
}
