{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reset observer report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "module_version", "implementation_hash", "generated_at", "state", "started_at", "estimand", "policy", "summary", "latest", "indicators", "outcome_providers", "outcomes", "scorecards", "comparisons", "curves"],
  "properties": {
    "schema_version": {"const": "reset-observer/1"},
    "module_version": {"type": "string"},
    "implementation_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "state": {"enum": ["collecting_forward_evidence", "scoring"]},
    "started_at": {"type": "string", "format": "date-time"},
    "estimand": {"type": "string"},
    "policy": {"type": "object", "required": ["version", "hash", "grid_seconds", "reporting_grace_seconds", "headline_sampling", "zero_label"]},
    "summary": {"type": "object", "required": ["forecast_snapshots", "frozen_trials", "scored_nonoverlapping_trials", "settlements", "outcomes", "settlement_revisions", "next_maturity"], "properties": {
      "scoring_by_horizon": {"type": "array", "maxItems": 4, "items": {"type": "object", "additionalProperties": false,
        "required": ["hours", "settled_windows", "scored_windows", "scored_trials", "eligible_rolling_trials", "missing_forecast_trials"],
        "properties": {"hours": {"enum": [6, 12, 24, 48]}, "settled_windows": {"type": "integer", "minimum": 0},
          "scored_windows": {"type": "integer", "minimum": 0}, "scored_trials": {"type": "integer", "minimum": 0},
          "eligible_rolling_trials": {"type": "integer", "minimum": 0}, "missing_forecast_trials": {"type": "integer", "minimum": 0}}}}
    }},
    "latest": {"type": "array", "items": {"type": "object", "required": ["source", "version", "target", "track", "origin", "received_at", "valid_until", "state", "probabilities_at_publication", "support_hours"]}},
    "indicators": {"type": "array", "items": {"type": "object"}},
    "calendar_sentiment": {"type": "object", "required": ["version", "minimum_recent_votes", "production_weight", "automatic_promotion", "latest", "trials", "sample_observations", "scored_days"],
      "properties": {"minimum_recent_votes": {"type": "integer", "minimum": 50}, "production_weight": {"const": 0},
        "automatic_promotion": {"const": false}, "latest": {"type": "array"}, "trials": {"type": "array"},
        "sample_observations": {"type": "integer", "minimum": 0}, "scored_days": {"type": "integer", "minimum": 0}}},
    "outcome_providers": {"type": "array", "items": {"type": "object"}},
    "outcomes": {"type": "array", "items": {"type": "object", "required": ["id", "status", "reason", "kind", "from", "to", "references", "time_basis"]}},
    "scorecards": {"type": "array", "items": {"type": "object", "required": ["source", "version", "target", "track", "hours", "scheduled_windows", "forecast_coverage", "settlement_states", "scores", "alerts"]}},
    "comparisons": {"type": "array", "items": {"type": "object", "required": ["left", "right", "target", "hours", "n", "loss_difference", "error_correlation", "brier_skill"]}},
    "curves": {"type": "array", "items": {"type": "object", "required": ["source", "version", "target", "track", "hours", "points"]}},
    "curve_basis": {"const": "received_publication_values"},
    "runtime": {"type": "object", "required": ["producer", "import", "pid"]},
    "diagnostics": {"type": "object", "required": ["unique_windows", "states", "unresolved_reasons", "windows", "runtime_events"]},
    "dependence": {"type": "array", "items": {"type": "object", "required": ["left", "right", "target", "matched_origins", "level_correlation", "change_correlation"]}},
    "weight_review": {"type": "object", "required": ["state", "automatic_promotion", "candidates", "selection"]},
    "reaction": {"type": "object", "additionalProperties": false,
      "required": ["version", "generated_at", "events"],
      "properties": {
        "version": {"const": "reset-reaction-1"},
        "generated_at": {"type": "number"},
        "initialized_at": {"type": "number"},
        "history_since": {"type": "number"},
        "events": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/reaction_event"}}
      }}
  },
  "$defs": {
    "nullable_clock": {"type": ["number", "null"]},
    "nullable_duration": {"type": ["number", "null"], "minimum": 0},
    "nullable_probability": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "reaction_evidence": {"type": "object", "additionalProperties": false,
      "required": ["provider", "source_family", "published_at", "first_received_at", "published_to_capture_seconds"],
      "properties": {
        "provider": {"type": "string"}, "source_family": {"type": "string"},
        "published_at": {"$ref": "#/$defs/nullable_clock"}, "first_received_at": {"type": "number"},
        "published_to_capture_seconds": {"$ref": "#/$defs/nullable_duration"}
      }},
    "reaction_series": {"type": "object", "additionalProperties": false,
      "required": ["source", "version", "target", "track", "state", "published_at", "source_received_at",
        "observer_received_at", "publication_to_capture_seconds", "completion_to_update_seconds", "known_to_update_seconds",
        "old_cycle_residual_seconds", "residual_censored", "before_probability_24h", "after_probability_24h",
        "ui_received_at", "ui_presented_at", "ui_delay_seconds", "missing_fields"],
      "properties": {
        "source": {"type": "string"}, "version": {"type": "string"},
        "target": {"enum": ["automatic_reset", "broad_quota_relief"]}, "track": {"enum": ["native", "model"]},
        "state": {"enum": ["updated", "awaiting_update", "anchor_unknown", "no_prior_observation"]},
        "published_at": {"$ref": "#/$defs/nullable_clock"}, "source_received_at": {"$ref": "#/$defs/nullable_clock"},
        "observer_received_at": {"$ref": "#/$defs/nullable_clock"},
        "publication_to_capture_seconds": {"$ref": "#/$defs/nullable_duration"},
        "completion_to_update_seconds": {"$ref": "#/$defs/nullable_duration"},
        "known_to_update_seconds": {"$ref": "#/$defs/nullable_duration"},
        "old_cycle_residual_seconds": {"$ref": "#/$defs/nullable_duration"}, "residual_censored": {"type": "boolean"},
        "before_probability_24h": {"$ref": "#/$defs/nullable_probability"},
        "after_probability_24h": {"$ref": "#/$defs/nullable_probability"},
        "ui_received_at": {"type": "null"}, "ui_presented_at": {"type": "null"}, "ui_delay_seconds": {"type": "null"},
        "missing_fields": {"type": "array", "uniqueItems": true, "items": {"enum": ["source_received_at", "ui_received_at"]}}
      }},
    "reaction_event": {"type": "object", "additionalProperties": false,
      "required": ["id", "kind", "status", "time_basis", "completed_from", "completed_to", "first_received_at", "evidence", "series"],
      "properties": {
        "id": {"type": "string"}, "kind": {"enum": ["automatic", "banked", "unknown"]},
        "status": {"enum": ["confirmed", "pending"]}, "time_basis": {"type": "string"},
        "completed_from": {"type": "number"}, "completed_to": {"type": "number"},
        "first_received_at": {"$ref": "#/$defs/nullable_clock"},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/reaction_evidence"}},
        "series": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/reaction_series"}}
      }}
  }
}
