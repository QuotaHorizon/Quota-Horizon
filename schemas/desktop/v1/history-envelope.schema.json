{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/codex-capacity-planner/desktop/v1/history-envelope.schema.json",
  "title": "Codex Capacity Planner desktop IPC history envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "reasonCode",
    "points"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "historyContextId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "overview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sampleCount", "dailyActivity"],
      "properties": {
        "sampleCount": { "type": "integer", "minimum": 0 },
        "dailyActivity": {
          "type": "array", "maxItems": 32,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["date", "sampleCount", "comparableIntervals", "consumedPercent"],
            "properties": {
              "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
              "sampleCount": { "type": "integer", "minimum": 1 },
              "comparableIntervals": { "type": "integer", "minimum": 0 },
              "consumedPercent": { "type": "number", "minimum": 0 }
            }
          }
        }
      }
    },
    "status": {
      "enum": [
        "available",
        "binding_required",
        "unavailable",
        "failed",
        "invalid_request"
      ]
    },
    "reasonCode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9_.]+$"
    },
    "points": {
      "type": "array",
      "maxItems": 2884,
      "items": {
        "$ref": "#/$defs/historyPoint"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "available"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "reasonCode": {
            "const": "history_available"
          }
        }
      },
      "else": {
        "properties": {
          "points": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "$defs": {
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "(?:Z|\\+00:00)$"
    },
    "historyPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshotId",
        "capturedAt",
        "limitId",
        "label",
        "windowMinutes",
        "usedPercent",
        "remainingPercent",
        "resetsAt",
        "availability",
        "compatibility"
      ],
      "properties": {
        "snapshotId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "capturedAt": {
          "$ref": "#/$defs/utcTimestamp"
        },
        "limitId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "label": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 256
        },
        "windowMinutes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "usedPercent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "multipleOf": 0.01
        },
        "remainingPercent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "multipleOf": 0.01
        },
        "resetsAt": {
          "oneOf": [
            {
              "$ref": "#/$defs/utcTimestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "availability": {
          "enum": [
            "complete",
            "partial"
          ]
        },
        "compatibility": {
          "enum": [
            "tested",
            "expected_compatible",
            "not_tested",
            "unsupported",
            "known_broken",
            "not_applicable"
          ]
        }
      }
    }
  }
}
