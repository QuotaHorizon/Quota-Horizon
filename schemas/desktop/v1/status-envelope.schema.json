{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/codex-capacity-planner/desktop/v1/status-envelope.schema.json",
  "title": "Codex Capacity Planner desktop IPC status envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sequence",
    "lifecycle",
    "status",
    "candidates",
    "selectedExecutableId",
    "issue",
    "persistenceEnabled"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "lifecycle": {
      "enum": [
        "idle",
        "ready",
        "stale",
        "selection_required",
        "error"
      ]
    },
    "status": {
      "oneOf": [
        {
          "$ref": "#/$defs/status"
        },
        {
          "type": "null"
        }
      ]
    },
    "candidates": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/candidate"
      }
    },
    "selectedExecutableId": {
      "oneOf": [
        {
          "$ref": "#/$defs/executableId"
        },
        {
          "type": "null"
        }
      ]
    },
    "issue": {
      "oneOf": [
        {
          "$ref": "#/$defs/issue"
        },
        {
          "type": "null"
        }
      ]
    },
    "persistenceEnabled": {
      "type": "boolean"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "lifecycle": {
            "const": "selection_required"
          }
        },
        "required": [
          "lifecycle"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "$ref": "#/$defs/emptyOrManagedQuotaStatus"
          },
          "candidates": {
            "minItems": 1
          },
          "selectedExecutableId": {
            "type": "null"
          },
          "issue": {
            "$ref": "#/$defs/issue"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lifecycle": {
            "enum": [
              "ready",
              "stale"
            ]
          }
        },
        "required": [
          "lifecycle"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "$ref": "#/$defs/status"
          },
          "candidates": {
            "maxItems": 0
          },
          "selectedExecutableId": {
            "$ref": "#/$defs/executableId"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lifecycle": {
            "const": "idle"
          }
        },
        "required": [
          "lifecycle"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "$ref": "#/$defs/emptyOrManagedQuotaStatus"
          },
          "candidates": {
            "maxItems": 0
          },
          "selectedExecutableId": {
            "$ref": "#/$defs/executableId"
          },
          "issue": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lifecycle": {
            "const": "error"
          }
        },
        "required": [
          "lifecycle"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "$ref": "#/$defs/emptyOrManagedQuotaStatus"
          },
          "candidates": {
            "maxItems": 0
          },
          "issue": {
            "$ref": "#/$defs/issue"
          }
        }
      }
    }
  ],
  "$defs": {
    "emptyOrManagedQuotaStatus": {
      "oneOf": [
        { "type": "null" },
        {
          "allOf": [
            { "$ref": "#/$defs/status" },
            {
              "required": ["quotaSource", "quotaObservedAt", "quotaFreshness"],
              "properties": {
                "quotaSource": { "const": "managed_account_cache" },
                "quotaFreshness": { "const": "stale" }
              }
            }
          ]
        }
      ]
    },
    "reasonCode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9_.]+$"
    },
    "boundedText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "(?:Z|\\+00:00)$"
    },
    "executableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "availability": {
      "enum": [
        "complete",
        "partial",
        "unsupported",
        "failed"
      ]
    },
    "freshness": {
      "enum": [
        "live",
        "stale",
        "not_applicable"
      ]
    },
    "compatibility": {
      "enum": [
        "tested",
        "expected_compatible",
        "not_tested",
        "unsupported",
        "known_broken",
        "not_applicable"
      ]
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "retryAfterMs"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/reasonCode"
        },
        "message": {
          "$ref": "#/$defs/boundedText"
        },
        "retryAfterMs": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 60000
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executableId",
        "canonicalPath",
        "version",
        "sources",
        "verification",
        "requiresConfirmation"
      ],
      "properties": {
        "executableId": {
          "$ref": "#/$defs/executableId"
        },
        "canonicalPath": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "version": {
          "oneOf": [
            {
              "$ref": "#/$defs/boundedText"
            },
            {
              "type": "null"
            }
          ]
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "explicit",
              "macos_chatgpt_bundle",
              "macos_bundle_registry",
              "path"
            ]
          }
        },
        "verification": {
          "enum": [
            "verified",
            "confirmation_required",
            "version_timeout",
            "version_failed"
          ]
        },
        "requiresConfirmation": {
          "type": "boolean"
        }
      }
    },
    "account": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authMode",
        "planType",
        "bindingStatus"
      ],
      "properties": {
        "authMode": {
          "oneOf": [
            {
              "$ref": "#/$defs/boundedText"
            },
            {
              "type": "null"
            }
          ]
        },
        "planType": {
          "oneOf": [
            {
              "$ref": "#/$defs/boundedText"
            },
            {
              "type": "null"
            }
          ]
        },
        "bindingStatus": {
          "enum": [
            "stable",
            "ephemeral",
            "unavailable"
          ]
        }
      }
    },
    "dataStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "availability",
        "freshness",
        "compatibility",
        "reasonCodes"
      ],
      "properties": {
        "availability": {
          "$ref": "#/$defs/availability"
        },
        "freshness": {
          "$ref": "#/$defs/freshness"
        },
        "compatibility": {
          "$ref": "#/$defs/compatibility"
        },
        "reasonCodes": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/reasonCode"
          }
        }
      }
    },
    "quotaWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "limitId",
        "label",
        "windowMinutes",
        "usedPercent",
        "remainingPercent",
        "resetsAt"
      ],
      "properties": {
        "limitId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "label": {
          "oneOf": [
            {
              "$ref": "#/$defs/boundedText"
            },
            {
              "type": "null"
            }
          ]
        },
        "windowMinutes": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 5256000
            },
            {
              "type": "null"
            }
          ]
        },
        "usedPercent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "remainingPercent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "resetsAt": {
          "oneOf": [
            {
              "$ref": "#/$defs/utcTimestamp"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "resetCredits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summaryStatus",
        "availableCount",
        "detailsStatus"
      ],
      "properties": {
        "summaryStatus": {
          "enum": [
            "available",
            "partial",
            "unavailable"
          ]
        },
        "availableCount": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "detailsStatus": {
          "enum": [
            "complete",
            "partial",
            "unavailable"
          ]
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "availability",
        "hasSummary",
        "reasonCodes"
      ],
      "properties": {
        "availability": {
          "$ref": "#/$defs/availability"
        },
        "hasSummary": {
          "type": "boolean"
        },
        "reasonCodes": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/reasonCode"
          }
        }
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "dependentRequired": {
        "quotaObservedAt": ["quotaFreshness", "quotaSource"],
        "quotaFreshness": ["quotaObservedAt", "quotaSource"],
        "quotaSource": ["quotaObservedAt", "quotaFreshness"]
      },
      "required": [
        "schemaVersion",
        "capturedAt",
        "codexVersion",
        "account",
        "dataStatus",
        "quotaWindows",
        "resetCredits",
        "usage",
        "diagnosticCodes"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0"
        },
        "capturedAt": {
          "$ref": "#/$defs/utcTimestamp"
        },
        "quotaObservedAt": {
          "$ref": "#/$defs/utcTimestamp"
        },
        "quotaFreshness": {
          "const": "stale"
        },
        "quotaSource": {
          "const": "managed_account_cache"
        },
        "codexVersion": {
          "oneOf": [
            {
              "$ref": "#/$defs/boundedText"
            },
            {
              "type": "null"
            }
          ]
        },
        "account": {
          "oneOf": [
            {
              "$ref": "#/$defs/account"
            },
            {
              "type": "null"
            }
          ]
        },
        "dataStatus": {
          "$ref": "#/$defs/dataStatus"
        },
        "quotaWindows": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/quotaWindow"
          }
        },
        "resetCredits": {
          "$ref": "#/$defs/resetCredits"
        },
        "usage": {
          "$ref": "#/$defs/usage"
        },
        "diagnosticCodes": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/reasonCode"
          }
        }
      }
    }
  }
}
